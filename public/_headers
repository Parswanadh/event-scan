# Cloudflare Workers Assets honours _headers for static responses.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# HTML must never be cached, or a deploy leaves phones serving the old shell.
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Our own modules change with every deploy; the filename does not, so revalidate.
/js/*
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: no-cache, must-revalidate

# The vendored barcode library is pinned to a version and never edited in place,
# so it is safe to cache hard.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: no-cache

/favicon.svg
  Cache-Control: public, max-age=604800

# The API sets its own no-store headers; this is a belt-and-braces default.
/api/*
  Cache-Control: no-store
