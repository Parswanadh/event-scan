# Copy to `.dev.vars` for local development with `wrangler dev`.
# In production these are set with:
#   wrangler secret put ORGANIZER_PIN
#   wrangler secret put SESSION_SECRET
#
# This file is an example and is committed on purpose. Never put real values here.

ORGANIZER_PIN="1234"

# Any long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET="replace-me-with-a-long-random-string"
