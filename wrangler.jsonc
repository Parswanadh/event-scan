{
  // Cloudflare Worker: barcode attendance scanner for scan.parswanadh.dev
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "event-scan",
  "main": "src/index.js",
  // Newest date supported by the installed workerd binary; see the note in
  // PROGRESS.md about bumping this only after upgrading wrangler.
  "compatibility_date": "2026-07-29",

  // Static front-end is served straight from ./public (no bundler, no build step).
  // run_worker_first sends only /api/* to the Worker script; everything else is
  // served by the asset layer without invoking the Worker at all.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // The glob matcher compiles "/api/*" to ^/api/.*$, which does NOT match
    // bare "/api" — hence both entries. Do not add "/api/docs" style rules
    // alongside "/api/*": a rule ending in * makes same-prefix rules a hard
    // config error.
    "run_worker_first": ["/api", "/api/*"]
  },

  // Fail the deploy early rather than 500-ing at runtime when a secret is unset.
  "secrets": {
    "required": ["ORGANIZER_PIN", "SESSION_SECRET"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "event-scan-db",
      "database_id": "ea2de699-3156-49f4-a2c6-b8722935fefc"
    }
  ],

  // Custom domain on the user's existing zone (Free plan).
  "routes": [
    {
      "pattern": "scan.parswanadh.dev",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "placement": {
    "mode": "smart"
  }
}
